# App
NODE_ENV=development
PORT=3000

# PostgreSQL (must match docker-compose or your DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack_secret
POSTGRES_DB=fintrack

# Connection URL (optional; if set, overrides individual vars above)
# Локально: postgresql://fintrack:fintrack_secret@localhost:5432/fintrack
# Продакшен (Supabase): Connect → URI, Method = Session pooler или Transaction pooler (порт 6543, не Direct — для IPv4/Vercel)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@...pooler.supabase.com:6543/postgres

# Auth — JWT (change in production)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Auth — cookie (refresh token). Локально: COOKIE_SAME_SITE=lax, COOKIE_CROSS_SITE не задавать.
# Прод: фронт https://fintrack... и API https://admin-fintrack... — кросс-сайт:
#   COOKIE_CROSS_SITE=1
#   COOKIE_SAME_SITE=none
#   COOKIE_DOMAIN=.kaz-ai.com
REFRESH_COOKIE_NAME=fintrack_refresh
COOKIE_SAME_SITE=lax
# COOKIE_CROSS_SITE=1
# COOKIE_DOMAIN=.kaz-ai.com

# Auth — Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# Frontend: для CORS (точный Origin, не *). Несколько origin через запятую.
FRONTEND_URL=http://localhost:3001
# Редирект после Google: FRONTEND_URL + этот путь + hash с токенами (по умолчанию /auth/callback)
# FRONTEND_OAUTH_CALLBACK_PATH=/auth/callback

# Mock billing (optional): BILLING_MOCK_ALWAYS_SUCCEED=1 — любая карта проходит
# BILLING_MOCK_RENEW=1 — разрешить POST /v1/billing/renew в production

OPENAI_API_KEY=sk-your-openai-key
AI_ENABLED=true
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=12000

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
